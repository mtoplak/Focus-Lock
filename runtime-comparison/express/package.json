{
  "name": "rc-express",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external",
    "start:prod": "node dist/server.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.3"
  }
}
